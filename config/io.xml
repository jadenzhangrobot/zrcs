<?xml version="1.0" encoding="UTF-8"?>
<IOConfig>
  <!-- 模拟量输入输出配置 -->
  <Analog>
    <Channel type="input" index="0">
      <Name>AI0</Name>
      <Address>0x3000</Address>
      <Range>0-10V</Range>
      <Scale>1.0</Scale>
      <Offset>0.0</Offset>
      <Filter>0.1</Filter>
    </Channel>
    <Channel type="output" index="0">
      <Name>AO0</Name>
      <Address>0x4000</Address>
      <Range>4-20mA</Range>
      <Scale>1.0</Scale>
      <Offset>0.0</Offset>
    </Channel>
  </Analog>
  <!-- 数字量输入输出配置 -->  
  <Digital>
    <Channel type="input" index="0">
      <Name>DI0</Name>
      <Address>0x5000</Address>
      <Invert>false</Invert>
      <Debounce>10</Debounce>
    </Channel>
    <Channel type="output" index="0">
      <Name>DO0</Name>
      <Address>0x6000</Address>
      <Invert>false</Invert>
    </Channel>
  </Digital>
</IOConfig>
