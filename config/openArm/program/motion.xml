            </Delay>
            <Action ID="MoveJ" name="蓝色圆柱_抬升"
                    X="0.187330" Y="0.051670" Z="-0.050000"
                    RX="0.0" RY="-1.200000" RZ="-1.000000" Vel="1.0"/>
            <Action ID="MoveJ" name="蓝色圆柱_投放"
                    X="0.317330" Y="0.251670" Z="-0.050000"
                    RX="0.0" RY="-1.200000" RZ="-1.000000" Vel="1.2"/>
            <SubTree ID="Open_Left_Gripper"/>
            <Delay delay_msec="400">
                <AlwaysSuccess/>
            </Delay>
            <Action ID="MoveJ" name="蓝色圆柱_撤离"
                    X="0.187330" Y="0.051670" Z="-0.080000"
                    RX="0.0" RY="-1.200000" RZ="-1.000000" Vel="1.2"/>
            <Action ID="MoveJ" name="回安全高位"
                    X="0.212857" Y="0.338516" Z="-0.138703"
                    RX="1.462092" RY="-0.561481" RZ="-1.368626" Vel="1.4"/>
        </Sequence>
    </BehaviorTree>

    <!--
      绿色球体：世界 (0.30, 0.10, 0.405)。
      腕姿 RPY≈(0, -77.3°, -57.3°)。
    -->
    <BehaviorTree ID="Pick_Green_Sphere_To_Bin">
        <Sequence>
            <SubTree ID="Open_Left_Gripper"/>
            <SubTree ID="Lift_To_Safe_Height"/>
            <Action ID="MoveJ" name="绿色球体_接近"
                    X="0.174043" Y="0.102750" Z="-0.080000"
                    RX="0.0" RY="-1.350000" RZ="-1.000000" Vel="1.2"/>
            <Action ID="MoveJ" name="绿色球体_夹取"
                    X="0.174043" Y="0.102750" Z="-0.225000"
                    RX="0.0" RY="-1.350000" RZ="-1.000000" Vel="0.7"/>
            <SubTree ID="Close_Left_Gripper"/>
            <Delay delay_msec="450">
                <AlwaysSuccess/>
            </Delay>
            <Action ID="MoveJ" name="绿色球体_抬升"
                    X="0.174043" Y="0.102750" Z="-0.050000"
                    RX="0.0" RY="-1.350000" RZ="-1.000000" Vel="1.0"/>
            <Action ID="MoveJ" name="绿色球体_投放"
                    X="0.234043" Y="0.262750" Z="-0.050000"
                    RX="0.0" RY="-1.350000" RZ="-1.000000" Vel="1.2"/>
            <SubTree ID="Open_Left_Gripper"/>
            <Delay delay_msec="400">
                <AlwaysSuccess/>
            </Delay>
            <Action ID="MoveJ" name="绿色球体_撤离"
                    X="0.234043" Y="0.262750" Z="-0.020000"
                    RX="0.0" RY="-1.350000" RZ="-1.000000" Vel="1.2"/>
            <Action ID="MoveJ" name="回安全高位"
                    X="0.212857" Y="0.338516" Z="-0.138703"
                    RX="1.462092" RY="-0.561481" RZ="-1.368626" Vel="1.4"/>
        </Sequence>
    </BehaviorTree>

    <!--
      完整抓取：仿真默认不使能。
      开头抬升一次到 stage，再依次抓三件；每件结束后回 stage。
      夹爪闭合保留 0.08 rad 目标以维持夹紧力，闭合后等待 450ms 再抬升。
    -->
    <BehaviorTree ID="Task_Pick_All_Objects_To_Bin">
        <Sequence>
            <SubTree ID="Open_Left_Gripper"/>
            <SubTree ID="Lift_To_Safe_Height"/>

            <Action ID="MoveJ" name="红方块_接近"
                    X="0.154800" Y="-0.018070" Z="-0.100000"
                    RX="0.0" RY="-1.308997" RZ="-1.047198" Vel="1.2"/>
            <Action ID="MoveJ" name="红方块_夹取"
                    X="0.154800" Y="-0.018070" Z="-0.220000"
                    RX="0.0" RY="-1.308997" RZ="-1.047198" Vel="0.7"/>
            <SubTree ID="Close_Left_Gripper"/>
            <Delay delay_msec="450">
                <AlwaysSuccess/>
            </Delay>
            <Action ID="MoveJ" name="红方块_抬升"
                    X="0.154800" Y="-0.018070" Z="-0.050000"
                    RX="0.0" RY="-1.308997" RZ="-1.047198" Vel="1.0"/>
            <Action ID="MoveJ" name="红方块_投放"
                    X="0.244800" Y="0.271930" Z="-0.050000"
                    RX="0.0" RY="-1.308997" RZ="-1.047198" Vel="1.2"/>
            <SubTree ID="Open_Left_Gripper"/>
            <Delay delay_msec="400">
                <AlwaysSuccess/>
            </Delay>
            <Action ID="MoveJ" name="红方块_撤离"
                    X="0.244800" Y="0.271930" Z="-0.020000"
                    RX="0.0" RY="-1.308997" RZ="-1.047198" Vel="1.2"/>
            <Action ID="MoveJ" name="回安全高位"
                    X="0.212857" Y="0.338516" Z="-0.138703"
                    RX="1.462092" RY="-0.561481" RZ="-1.368626" Vel="1.4"/>

            <Action ID="MoveJ" name="蓝色圆柱_接近"
                    X="0.187330" Y="0.051670" Z="-0.080000"
                    RX="0.0" RY="-1.200000" RZ="-1.000000" Vel="1.2"/>
            <Action ID="MoveJ" name="蓝色圆柱_夹取"
                    X="0.187330" Y="0.051670" Z="-0.200000"
                    RX="0.0" RY="-1.200000" RZ="-1.000000" Vel="0.7"/>
            <SubTree ID="Close_Left_Gripper"/>
            <Delay delay_msec="450">
                <AlwaysSuccess/>
            </Delay>
            <Action ID="MoveJ" name="蓝色圆柱_抬升"
                    X="0.187330" Y="0.051670" Z="-0.050000"
                    RX="0.0" RY="-1.200000" RZ="-1.000000" Vel="1.0"/>
            <Action ID="MoveJ" name="蓝色圆柱_投放"
                    X="0.317330" Y="0.251670" Z="-0.050000"
                    RX="0.0" RY="-1.200000" RZ="-1.000000" Vel="1.2"/>
            <SubTree ID="Open_Left_Gripper"/>
            <Delay delay_msec="400">
                <AlwaysSuccess/>
            </Delay>
            <Action ID="MoveJ" name="蓝色圆柱_撤离"
                    X="0.187330" Y="0.051670" Z="-0.080000"
                    RX="0.0" RY="-1.200000" RZ="-1.000000" Vel="1.2"/>
            <Action ID="MoveJ" name="回安全高位"
                    X="0.212857" Y="0.338516" Z="-0.138703"
                    RX="1.462092" RY="-0.561481" RZ="-1.368626" Vel="1.4"/>

            <Action ID="MoveJ" name="绿色球体_接近"
                    X="0.174043" Y="0.102750" Z="-0.080000"
                    RX="0.0" RY="-1.350000" RZ="-1.000000" Vel="1.2"/>
            <Action ID="MoveJ" name="绿色球体_夹取"
                    X="0.174043" Y="0.102750" Z="-0.225000"
