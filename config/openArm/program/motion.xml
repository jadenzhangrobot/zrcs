    <!-- 自定义节点端口模型供 GUI 行为树编辑器展示；运行时以 NRT 注册端口为准。 -->
    <TreeNodesModel>
        <Action ID="Enable">
            <input_port name="AxisId" type="double" default="0.0">轴号</input_port>
        </Action>
        <Action ID="Disable">
            <input_port name="AxisId" type="double" default="0.0">轴号</input_port>
        </Action>
        <Action ID="Reset">
            <input_port name="AxisId" type="double" default="0.0">轴号；16 表示全部轴</input_port>
        </Action>
        <Action ID="SetZero">
            <input_port name="AxisId" type="double" default="0.0">轴号；16 表示全部轴</input_port>
        </Action>
        <Action ID="JogJ">
            <input_port name="AxisId" type="double" default="0.0">轴号</input_port>
            <input_port name="TargetPosition" type="double" default="0.0">相对位移，单位 rad</input_port>
        </Action>
        <Action ID="JogabsJ">
            <input_port name="AxisId" type="double" default="0.0">轴号</input_port>
            <input_port name="TargetPosition" type="double" default="0.0">绝对位置，单位 rad</input_port>
        </Action>
        <Action ID="MoveAbs">
            <input_port name="AxisId" type="double" default="0.0">轴号</input_port>
            <input_port name="Position" type="double" default="0.0">绝对目标位置，单位 rad</input_port>
            <input_port name="Vel" type="double" default="0.25">最大速度，单位 rad/s</input_port>
            <input_port name="Acc" type="double" default="0.50">最大加速度，单位 rad/s^2</input_port>
            <input_port name="Jerk" type="double" default="2.0">最大加加速度，单位 rad/s^3</input_port>
        </Action>
        <Action ID="MoveL">
            <input_port name="CurrentX" type="double" default="0.0">起点 X (m)</input_port>
            <input_port name="CurrentY" type="double" default="0.0">起点 Y (m)</input_port>
            <input_port name="CurrentZ" type="double" default="0.0">起点 Z (m)</input_port>
            <input_port name="CurrentQ1" type="double" default="1.0">起点 Qw</input_port>
            <input_port name="CurrentQ2" type="double" default="0.0">起点 Qx</input_port>
            <input_port name="CurrentQ3" type="double" default="0.0">起点 Qy</input_port>
            <input_port name="CurrentQ4" type="double" default="0.0">起点 Qz</input_port>
            <input_port name="X" type="double" default="0.0">目标 X (m)</input_port>
            <input_port name="Y" type="double" default="0.0">目标 Y (m)</input_port>
            <input_port name="Z" type="double" default="0.0">目标 Z (m)</input_port>
            <input_port name="Q1" type="double" default="1.0">目标 Qw</input_port>
            <input_port name="Q2" type="double" default="0.0">目标 Qx</input_port>
            <input_port name="Q3" type="double" default="0.0">目标 Qy</input_port>
            <input_port name="Q4" type="double" default="0.0">目标 Qz</input_port>
            <input_port name="Vel" type="double" default="0.05">最大速度 (m/s)</input_port>
            <input_port name="TargetVel" type="double" default="0.0">终点速度 (m/s)</input_port>
            <input_port name="Sync" type="double" default="0.0">1=新轨迹组, 0=接力</input_port>
        </Action>
        <Action ID="MoveJ">
            <input_port name="X" type="double" default="0.0">目标 X (m)</input_port>
            <input_port name="Y" type="double" default="0.0">目标 Y (m)</input_port>
            <input_port name="Z" type="double" default="0.0">目标 Z (m)</input_port>
            <input_port name="RX" type="double" default="0.0">目标 RX (rad)</input_port>
            <input_port name="RY" type="double" default="0.0">目标 RY (rad)</input_port>
            <input_port name="RZ" type="double" default="0.0">目标 RZ (rad)</input_port>
            <input_port name="Vel" type="double" default="0.5">速度缩放因子</input_port>
        </Action>
    </TreeNodesModel>
