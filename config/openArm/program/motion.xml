<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="Task_Pick_All_Objects_To_Bin">
    <!--
      openArm 双臂工程行为树示例

      轴号约定（与 axis.xml 一致）：
        0-6   左臂 7 个关节
        7     左夹爪
        8-14  右臂 7 个关节
        15    右夹爪

      运行约定：
        1. 默认主树 Task_Pick_All_Objects_To_Bin 面向 MuJoCo 仿真：不发送 Enable。
           仿真里轴可直接 MoveAbs/MoveJ；点 START 前请重新加载场景，确认物件在初始位。
        2. 真机调试时再手动插入 Enable_Left_Arm / Disable_Left_Arm。
        3. OpenArm_Overview 是不发送控制命令的安全预览树。
        4. 抓取路径采用“关节先抬高 + MoveJ PTP”，避免 home 低于桌面时笛卡尔直线穿桌。
        5. 当前 MoveAbsJ 只定义 J1-J6，7 轴单臂抬升用多个 MoveAbs。
        6. AxisId=16 在 Reset 中表示全部轴；本文件不提供全轴 SetZero。
    -->

    <!-- 安全预览入口：仅返回成功，不向实时控制进程发送命令。 -->
    <BehaviorTree ID="OpenArm_Overview">
        <AlwaysSuccess/>
    </BehaviorTree>

    <!-- 左臂逐轴使能。夹爪轴 7 单独列在最后，便于从 GUI 中删除或调整。 -->
    <BehaviorTree ID="Enable_Left_Arm">
        <Sequence>
            <Action ID="Enable" AxisId="0"/>
            <Action ID="Enable" AxisId="1"/>
            <Action ID="Enable" AxisId="2"/>
            <Action ID="Enable" AxisId="3"/>
            <Action ID="Enable" AxisId="4"/>
            <Action ID="Enable" AxisId="5"/>
            <Action ID="Enable" AxisId="6"/>
            <Action ID="Enable" AxisId="7"/>
        </Sequence>
    </BehaviorTree>

    <!-- 右臂逐轴使能，轴号从 8 开始。 -->
    <BehaviorTree ID="Enable_Right_Arm">
        <Sequence>
            <Action ID="Enable" AxisId="8"/>
            <Action ID="Enable" AxisId="9"/>
            <Action ID="Enable" AxisId="10"/>
            <Action ID="Enable" AxisId="11"/>
            <Action ID="Enable" AxisId="12"/>
            <Action ID="Enable" AxisId="13"/>
            <Action ID="Enable" AxisId="14"/>
            <Action ID="Enable" AxisId="15"/>
        </Sequence>
    </BehaviorTree>

    <!-- 左臂逐轴失能。 -->
    <BehaviorTree ID="Disable_Left_Arm">
        <Sequence>
            <Action ID="Disable" AxisId="0"/>
            <Action ID="Disable" AxisId="1"/>
            <Action ID="Disable" AxisId="2"/>
            <Action ID="Disable" AxisId="3"/>
            <Action ID="Disable" AxisId="4"/>
            <Action ID="Disable" AxisId="5"/>
            <Action ID="Disable" AxisId="6"/>
            <Action ID="Disable" AxisId="7"/>
        </Sequence>
    </BehaviorTree>

    <!-- 右臂逐轴失能。 -->
    <BehaviorTree ID="Disable_Right_Arm">
        <Sequence>
            <Action ID="Disable" AxisId="8"/>
            <Action ID="Disable" AxisId="9"/>
            <Action ID="Disable" AxisId="10"/>
            <Action ID="Disable" AxisId="11"/>
            <Action ID="Disable" AxisId="12"/>
            <Action ID="Disable" AxisId="13"/>
            <Action ID="Disable" AxisId="14"/>
            <Action ID="Disable" AxisId="15"/>
        </Sequence>
    </BehaviorTree>

    <!-- AxisId 等于轴总数时，Reset 会遍历并复位全部轴。 -->
    <BehaviorTree ID="Reset_All">
        <Action ID="Reset" AxisId="16"/>
    </BehaviorTree>

    <!-- 单关节低速绝对定位示例，目标均位于 axis.xml 限位范围内，单位为 rad。 -->
    <BehaviorTree ID="Move_Left_Joint1_Demo">
        <Action ID="MoveAbs" AxisId="0" Position="0.10" Vel="0.25" Acc="0.50" Jerk="2.0"/>
    </BehaviorTree>

    <BehaviorTree ID="Move_Right_Joint1_Demo">
        <Action ID="MoveAbs" AxisId="8" Position="-0.10" Vel="0.25" Acc="0.50" Jerk="2.0"/>
    </BehaviorTree>

    <!--
      夹爪绝对位置示例：
        - 左夹爪范围 0...+0.7854 rad，0 为闭合，正角度为张开。
        - 右夹爪范围 -0.7854...0 rad，0 为闭合，负角度为张开。
      抓取场景中的物件最大宽度约 0.056 m，使用 0.55 rad 的张开量可避免
      接近时指爪提前碰到物件；闭合目标设为 0，由 MuJoCo 接触力阻止指爪穿透物件。
    -->
    <!--
      夹爪策略：
        - 张开 0.55 rad，接近时不提前碰到中等宽度物件。
        - 闭合不要追到绝对 0：保留约 0.08 rad 目标，让位置环持续输出夹紧力。
          否则接触后目标已到达，夹持力会掉，物体像“假体/抓不住”。
    -->
    <BehaviorTree ID="Close_Left_Gripper">
        <Action ID="MoveAbs" AxisId="7" Position="0.08" Vel="1.2" Acc="6.0" Jerk="25.0"/>
    </BehaviorTree>

    <BehaviorTree ID="Open_Left_Gripper">
        <Action ID="MoveAbs" AxisId="7" Position="0.55" Vel="2.0" Acc="10.0" Jerk="40.0"/>
    </BehaviorTree>

    <BehaviorTree ID="Close_Right_Gripper">
        <Action ID="MoveAbs" AxisId="15" Position="-0.08" Vel="1.2" Acc="6.0" Jerk="25.0"/>
    </BehaviorTree>

    <BehaviorTree ID="Open_Right_Gripper">
        <Action ID="MoveAbs" AxisId="15" Position="-0.55" Vel="2.0" Acc="10.0" Jerk="40.0"/>
    </BehaviorTree>

    <!-- ================================================================= -->
    <!-- MoveL 笛卡尔直线测试节点                                          -->
    <!--                                                                  -->
    <!-- 前提: 机械臂在 home 位姿 (q=0)                                    -->
    <!--   FK: pos=(0, +/-0.1225, -0.436)  quat=(1,0,0,0)                 -->
    <!--                                                                  -->
    <!-- 工作空间约束: sqrt(X² + Z²) ≤ 0.436 m                             -->
    <!--   home Z=-0.436 时 arm 完全伸展, 必须同时抬高 Z 才能水平移动      -->
    <!--                                                                  -->
    <!-- 单位: X/Y/Z=m, Q1/Q2/Q3/Q4=四元数(w,x,y,z), Vel=m/s              -->
    <!-- ================================================================= -->

    <!-- 测试 1: home → 前上方 5cm (最基础的 MoveL 验证) -->
    <BehaviorTree ID="MoveL_Forward_5cm">
        <Sequence>
            <Action ID="MoveL"
                    X="0.05" Y="0.1225" Z="-0.386"
                    Q1="1" Q2="0" Q3="0" Q4="0"
                    Vel="0.05" Sync="1"/>
        </Sequence>
    </BehaviorTree>

    <!-- 测试 2: home → 前上方 8cm -->
    <BehaviorTree ID="MoveL_Forward_8cm">
        <Sequence>
            <Action ID="MoveL"
                    X="0.08" Y="0.1225" Z="-0.35"
                    Q1="1" Q2="0" Q3="0" Q4="0"
                    Vel="0.05" Sync="1"/>
        </Sequence>
    </BehaviorTree>

    <!-- 测试 3: home → 向上收起 (纯 Z 轴运动) -->
    <BehaviorTree ID="MoveL_Up_10cm">
        <Sequence>
            <Action ID="MoveL"
                    X="0" Y="0.1225" Z="-0.30"
                    Q1="1" Q2="0" Q3="0" Q4="0"
                    Vel="0.05" Sync="1"/>
        </Sequence>
    </BehaviorTree>

    <!-- 测试 4: 带姿态旋转 (末端绕 X 转 30°) -->
    <BehaviorTree ID="MoveL_Rotate_30deg">
        <Sequence>
            <Action ID="MoveL"
                    X="0" Y="0.1225" Z="-0.35"
                    Q1="0.9659" Q2="0.2588" Q3="0" Q4="0"
                    Vel="0.03" Sync="1"/>
        </Sequence>
    </BehaviorTree>

    <!-- 测试 5: 三段式直线接力 (Sync=1 新轨迹组, Sync=0 接力) -->
    <BehaviorTree ID="MoveL_3Seg_Path">
        <Sequence>
            <Action ID="MoveL"
                    X="0.04" Y="0.1225" Z="-0.40"
                    Q1="1" Q2="0" Q3="0" Q4="0"
                    Vel="0.05" TargetVel="0.05" Sync="1"/>
            <Action ID="MoveL"
                    X="0.08" Y="0.1225" Z="-0.35"
                    Q1="1" Q2="0" Q3="0" Q4="0"
                    Vel="0.05" TargetVel="0.05" Sync="0"/>
            <Action ID="MoveL"
                    X="0.08" Y="0.1225" Z="-0.25"
                    Q1="1" Q2="0" Q3="0" Q4="0"
                    Vel="0.05" TargetVel="0.0" Sync="0"/>
        </Sequence>
    </BehaviorTree>

    <!-- 测试 6: 正方形路径 (FK 自动计算每段起点) -->
    <BehaviorTree ID="MoveL_Square">
        <Sequence>
            <Action ID="MoveL"
                    X="0.06" Y="0.1225" Z="-0.38"
                    Q1="1" Q2="0" Q3="0" Q4="0"
                    Vel="0.05" TargetVel="0.05" Sync="1"/>
            <Action ID="MoveL"
                    X="0.06" Y="0.1625" Z="-0.38"
                    Q1="1" Q2="0" Q3="0" Q4="0"
                    Vel="0.03" TargetVel="0.03" Sync="0"/>
            <Action ID="MoveL"
                    X="0.10" Y="0.1625" Z="-0.38"
                    Q1="1" Q2="0" Q3="0" Q4="0"
                    Vel="0.03" TargetVel="0.03" Sync="0"/>
            <Action ID="MoveL"
                    X="0.10" Y="0.1225" Z="-0.38"
                    Q1="1" Q2="0" Q3="0" Q4="0"
                    Vel="0.03" TargetVel="0.0" Sync="0"/>
        </Sequence>
    </BehaviorTree>

    <!-- ================================================================= -->
    <!-- MoveJ 笛卡尔 PTP 测试节点 (目标位姿 → IK → 关节空间轨迹)          -->
    <!-- ================================================================= -->

    <!-- PTP 到前上方 (与 MoveL_Forward_8cm 同目标, 对比直线 vs PTP) -->
    <BehaviorTree ID="MoveJ_To_Forward">
        <Sequence>
            <Action ID="MoveJ"
                    X="0.08" Y="0.1225" Z="-0.35"
                    RX="0" RY="0" RZ="0"
                    Vel="0.5"/>
        </Sequence>
    </BehaviorTree>

    <!-- PTP 到上方收起位姿 -->
    <BehaviorTree ID="MoveJ_To_Up">
        <Sequence>
            <Action ID="MoveJ"
                    X="0" Y="0.1225" Z="-0.25"
                    RX="0" RY="0" RZ="0"
                    Vel="0.5"/>
        </Sequence>
    </BehaviorTree>

    <!-- PTP 回到 home -->
    <BehaviorTree ID="MoveJ_To_Home">
        <Sequence>
            <Action ID="MoveJ"
                    X="0" Y="0.1225" Z="-0.436"
                    RX="0" RY="0" RZ="0"
                    Vel="0.5"/>
        </Sequence>
    </BehaviorTree>

    <!-- ================================================================= -->
    <!-- 左臂桌面抓取节点                                                   -->
    <!--                                                                  -->
    <!-- 场景（robot.xml）：                                                -->
    <!--   桌面世界高度 0.375 m；臂基座世界 Z=0.698 m。                      -->
    <!--   home q=0 时腕部臂坐标 (0, 0.1225, -0.436)，世界高度仅 0.262 m，  -->
    <!--   低于桌面。因此不能 home 直接笛卡尔去桌面。                        -->
    <!--                                                                  -->
    <!-- 路径策略（关节空间，已用 MuJoCo 碰撞采样验证）：                     -->
    <!--   1. MoveAbs 先 j1=-1.0 抬肩（世界高度到 ~0.46 m，越过桌面）        -->
    <!--   2. MoveAbs 再 j3=1.4 弯肘到安全高位 stage                         -->
    <!--   3. 全程 MoveJ PTP：接近 → 夹取 → 抬升 → 投放 → 撤离 → 回 stage  -->
    <!--   4. 仿真不需要 Enable；速度按 axis 上限比例，比旧 MoveL 快很多。  -->
    <!-- ================================================================= -->

    <!-- 关节空间抬到安全高位：先肩后肘，避免肘伸展时扫桌。 -->
    <BehaviorTree ID="Lift_To_Safe_Height">
        <Sequence>
            <Action ID="MoveAbs" name="抬肩" AxisId="1" Position="-1.0"
                    Vel="2.5" Acc="15.0" Jerk="40.0"/>
            <Action ID="MoveAbs" name="弯肘" AxisId="3" Position="1.4"
                    Vel="2.5" Acc="15.0" Jerk="40.0"/>
        </Sequence>
    </BehaviorTree>

    <!-- 安全高位笛卡尔描述（与上列关节目标等价，供 MoveJ 回程使用）。 -->
    <!-- stage q ≈ [0, -1.0, 0, 1.4, 0, 0, 0] -->
    <!-- stage pose ≈ (0.212857, 0.338516, -0.138703), RPY 见下方 MoveJ -->

    <!--
      红色方块：世界 (0.22, -0.10, 0.412)。
      腕姿偏斜向下（当前臂型完全垂直桌面位 IK 困难）。夹取高度已按指尖包络上调。
    -->
    <BehaviorTree ID="Pick_Red_Block_To_Bin">
        <Sequence>
            <SubTree ID="Open_Left_Gripper"/>
            <SubTree ID="Lift_To_Safe_Height"/>
            <Action ID="MoveJ" name="红方块_接近"
                    X="0.154800" Y="-0.018070" Z="-0.100000"
                    RX="0.0" RY="-1.308997" RZ="-1.047198" Vel="1.2"/>
            <Action ID="MoveJ" name="红方块_夹取"
                    X="0.154800" Y="-0.018070" Z="-0.220000"
                    RX="0.0" RY="-1.308997" RZ="-1.047198" Vel="0.7"/>
            <SubTree ID="Close_Left_Gripper"/>
            <Delay delay_msec="450">
                <AlwaysSuccess/>
            </Delay>
            <Action ID="MoveJ" name="红方块_抬升"
                    X="0.154800" Y="-0.018070" Z="-0.050000"
                    RX="0.0" RY="-1.308997" RZ="-1.047198" Vel="1.0"/>
            <Action ID="MoveJ" name="红方块_投放"
                    X="0.244800" Y="0.271930" Z="-0.050000"
                    RX="0.0" RY="-1.308997" RZ="-1.047198" Vel="1.2"/>
            <SubTree ID="Open_Left_Gripper"/>
            <Delay delay_msec="400">
                <AlwaysSuccess/>
            </Delay>
            <Action ID="MoveJ" name="红方块_撤离"
                    X="0.244800" Y="0.271930" Z="-0.020000"
                    RX="0.0" RY="-1.308997" RZ="-1.047198" Vel="1.2"/>
            <Action ID="MoveJ" name="回安全高位"
                    X="0.212857" Y="0.338516" Z="-0.138703"
                    RX="1.462092" RY="-0.561481" RZ="-1.368626" Vel="1.4"/>
        </Sequence>
    </BehaviorTree>

    <!--
      蓝色圆柱：世界 (0.27, 0.00, 0.412)。
      腕姿 RPY≈(0, -68.8°, -57.3°)。
    -->
    <BehaviorTree ID="Pick_Blue_Cylinder_To_Bin">
        <Sequence>
            <SubTree ID="Open_Left_Gripper"/>
            <SubTree ID="Lift_To_Safe_Height"/>
            <Action ID="MoveJ" name="蓝色圆柱_接近"
