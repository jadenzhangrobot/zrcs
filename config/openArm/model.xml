<?xml version="1.0" encoding="utf-8"?>
<!--
  openArm v2.0 双臂机器人模型配置
  ====================================

  运动学: POE 正运动学 + Singh-Kreutz SRS 解析逆解 (7-DOF 每臂)
  参数来源: MuJoCo openarm_bimanual.xml → ssik prebuilt → 本文件

  几何参数 (左右臂共享连杆长度, Y 轴方向镜像):
    上臂长度 L_se = 0.220 m
    前臂长度 L_ew = 0.216 m
    最大可达距离 ≈ 0.436 m

  关节限位: 与 config/openarm/axis.xml 一致

  子模型:
    openarm_left  — 左臂 (类型 openarm_srs)
    openarm_right — 右臂 (类型 openarm_srs)
-->
<cereal>
    <modelConfig>
        <models size="dynamic">
            <!-- ===================================================== -->
            <!-- 左臂: 7-DOF SRS, Side::LEFT, axisId 0-6 -->
            <!-- ===================================================== -->
            <value0>
                <name>openarm_left</name>
                <type>openarm_srs</type>
                <dof>7</dof>
                <baseFrame>
                    <x>0</x> <y>0</y> <z>0</z>
                    <rx>0</rx> <ry>0</ry> <rz>0</rz>
                </baseFrame>
                <toolFrame>
                    <x>0</x> <y>0</y> <z>0</z>
                    <rx>0</rx> <ry>0</ry> <rz>0</rz>
                </toolFrame>
                <basePlatformRadius>0</basePlatformRadius>
                <mobilePlatformRadius>0</mobilePlatformRadius>
                <upperArmLength>0</upperArmLength>
                <lowerArmLength>0</lowerArmLength>
                <!-- joints 仅用于 axisId 映射; DH 参数不适用于 POE 运动学 -->
                <joints size="dynamic">
                    <value0>
                        <axisId>0</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value0>
                    <value1>
                        <axisId>1</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value1>
                    <value2>
                        <axisId>2</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value2>
                    <value3>
                        <axisId>3</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value3>
                    <value4>
                        <axisId>4</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value4>
                    <value5>
                        <axisId>5</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value5>
                    <value6>
                        <axisId>6</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value6>
                </joints>
            </value0>

            <!-- ===================================================== -->
            <!-- 右臂: 7-DOF SRS, Side::RIGHT, axisId 8-14 -->
            <!-- ===================================================== -->
            <value1>
                <name>openarm_right</name>
                <type>openarm_srs</type>
                <dof>7</dof>
                <baseFrame>
                    <x>0</x> <y>0</y> <z>0</z>
                    <rx>0</rx> <ry>0</ry> <rz>0</rz>
                </baseFrame>
                <toolFrame>
                    <x>0</x> <y>0</y> <z>0</z>
                    <rx>0</rx> <ry>0</ry> <rz>0</rz>
                </toolFrame>
                <basePlatformRadius>0</basePlatformRadius>
                <mobilePlatformRadius>0</mobilePlatformRadius>
                <upperArmLength>0</upperArmLength>
                <lowerArmLength>0</lowerArmLength>
                <joints size="dynamic">
                    <value0>
                        <axisId>8</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value0>
                    <value1>
                        <axisId>9</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value1>
                    <value2>
                        <axisId>10</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value2>
                    <value3>
                        <axisId>11</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value3>
                    <value4>
                        <axisId>12</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value4>
                    <value5>
                        <axisId>13</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value5>
                    <value6>
                        <axisId>14</axisId>
                        <type>revolute</type> <offset>0</offset>
                        <dh_a>0</dh_a> <dh_alpha>0</dh_alpha> <dh_d>0</dh_d> <dh_theta>0</dh_theta>
                        <axis>X</axis>
                    </value6>
                </joints>
            </value1>
        </models>
    </modelConfig>
</cereal>
