<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="Cmd_MoveL_Batch">
    <!--
      命令行为树节点目录
      说明:
      1. 主树 CommandCatalog 只打印说明，不执行任何实际运动。
      2. 每个 BehaviorTree ID 对应一个 zrcs_rt 命令动作节点示例子树。
      3. 参数名与 CmdDefine.h 中 Arg 枚举成员名一致，类型为 double。
      4. 可在 GUI/Groot 中加载本文件，再切换 main_tree_to_execute 或复制对应子树使用。
    -->

    <TreeNodesModel>
        <Action ID="LogMessage">
            <input_port name="message" type="std::string">Log text</input_port>
        </Action>
        <Action ID="SetTaskState">
            <input_port name="state" type="std::string">Task state: RUN/STOP/RESET/START/SHUTDOWN</input_port>
        </Action>
        <!-- ===== Typed command nodes (one port per Arg enum member) ===== -->
        <Action ID="Enable">
            <input_port name="AxisId" type="double" default="0.0">Axis ID (0=all axes)</input_port>
        </Action>
        <Action ID="Disable">
            <input_port name="AxisId" type="double" default="0.0">Axis ID (0=all axes)</input_port>
        </Action>
        <Action ID="Reset">
            <input_port name="AxisId" type="double" default="0.0">Axis ID (0=all axes)</input_port>
        </Action>
        <Action ID="Setmode">
            <input_port name="AxisId" type="double" default="0.0">Axis ID</input_port>
            <input_port name="Mode" type="double" default="0.0">Operation mode</input_port>
        </Action>
        <Action ID="SetZero">
            <input_port name="AxisId" type="double" default="0.0">Axis ID</input_port>
        </Action>
        <Action ID="JogabsJ">
            <input_port name="AxisId" type="double" default="0.0">Axis ID</input_port>
            <input_port name="TargetPosition" type="double" default="0.0">Target position</input_port>
        </Action>
        <Action ID="JogJ">
            <input_port name="AxisId" type="double" default="0.0">Axis ID</input_port>
            <input_port name="TargetPosition" type="double" default="0.0">Target position</input_port>
        </Action>
        <Action ID="MoveAbs">
            <input_port name="AxisId" type="double" default="0.0">Axis ID</input_port>
            <input_port name="Position" type="double" default="0.0">Target position</input_port>
            <input_port name="Vel" type="double" default="50.0">Max velocity</input_port>
            <input_port name="Acc" type="double" default="100.0">Max acceleration</input_port>
            <input_port name="Jerk" type="double" default="500.0">Max jerk</input_port>
        </Action>
        <Action ID="MoveAbsJ">
            <input_port name="Count" type="double" default="6.0">Active joint count</input_port>
            <input_port name="J1" type="double" default="0.0">Joint 1 target</input_port>
            <input_port name="J2" type="double" default="0.0">Joint 2 target</input_port>
            <input_port name="J3" type="double" default="0.0">Joint 3 target</input_port>
            <input_port name="J4" type="double" default="0.0">Joint 4 target</input_port>
            <input_port name="J5" type="double" default="0.0">Joint 5 target</input_port>
            <input_port name="J6" type="double" default="0.0">Joint 6 target</input_port>
        </Action>
        <Action ID="MoveJ">
            <input_port name="X" type="double" default="0.0">Target X (mm)</input_port>
            <input_port name="Y" type="double" default="0.0">Target Y (mm)</input_port>
            <input_port name="Z" type="double" default="0.0">Target Z (mm)</input_port>
            <input_port name="RX" type="double" default="0.0">Target RX (deg)</input_port>
            <input_port name="RY" type="double" default="0.0">Target RY (deg)</input_port>
            <input_port name="RZ" type="double" default="0.0">Target RZ (deg)</input_port>
            <input_port name="Vel" type="double" default="50.0">Max velocity</input_port>
        </Action>
        <Action ID="MoveL">
            <input_port name="CurrentX" type="double" default="0.0">Start X</input_port>
            <input_port name="CurrentY" type="double" default="0.0">Start Y</input_port>
            <input_port name="CurrentZ" type="double" default="0.0">Start Z</input_port>
            <input_port name="CurrentQ1" type="double" default="1.0">Start Qw</input_port>
            <input_port name="CurrentQ2" type="double" default="0.0">Start Qx</input_port>
            <input_port name="CurrentQ3" type="double" default="0.0">Start Qy</input_port>
            <input_port name="CurrentQ4" type="double" default="0.0">Start Qz</input_port>
            <input_port name="X" type="double" default="0.0">Target X</input_port>
            <input_port name="Y" type="double" default="0.0">Target Y</input_port>
            <input_port name="Z" type="double" default="0.0">Target Z</input_port>
            <input_port name="Q1" type="double" default="1.0">Target Qw</input_port>
            <input_port name="Q2" type="double" default="0.0">Target Qx</input_port>
            <input_port name="Q3" type="double" default="0.0">Target Qy</input_port>
            <input_port name="Q4" type="double" default="0.0">Target Qz</input_port>
            <input_port name="Vel" type="double" default="50.0">Max velocity</input_port>
            <input_port name="CurrentVel" type="double" default="0.0">Start velocity</input_port>
            <input_port name="TargetVel" type="double" default="50.0">End velocity</input_port>
        </Action>
        <Action ID="MoveC">
            <input_port name="ViaX" type="double" default="0.0">Via point X</input_port>
            <input_port name="ViaY" type="double" default="0.0">Via point Y</input_port>
            <input_port name="ViaZ" type="double" default="0.0">Via point Z</input_port>
            <input_port name="EndX" type="double" default="0.0">End point X</input_port>
            <input_port name="EndY" type="double" default="0.0">End point Y</input_port>
            <input_port name="EndZ" type="double" default="0.0">End point Z</input_port>
            <input_port name="Vel" type="double" default="50.0">Max velocity</input_port>
        </Action>
        <Action ID="Movehome">
            <!-- No input ports: Movehome takes zero parameters -->
        </Action>
        <Action ID="MoveLGalvo">
            <input_port name="CurrentX" type="double" default="0.0">Start X</input_port>
            <input_port name="CurrentY" type="double" default="0.0">Start Y</input_port>
            <input_port name="CurrentZ" type="double" default="0.0">Start Z</input_port>
            <input_port name="CurrentQ1" type="double" default="1.0">Start Qw</input_port>
            <input_port name="CurrentQ2" type="double" default="0.0">Start Qx</input_port>
            <input_port name="CurrentQ3" type="double" default="0.0">Start Qy</input_port>
            <input_port name="CurrentQ4" type="double" default="0.0">Start Qz</input_port>
            <input_port name="X" type="double" default="0.0">Target X</input_port>
            <input_port name="Y" type="double" default="0.0">Target Y</input_port>
            <input_port name="Z" type="double" default="0.0">Target Z</input_port>
            <input_port name="Q1" type="double" default="1.0">Target Qw</input_port>
            <input_port name="Q2" type="double" default="0.0">Target Qx</input_port>
            <input_port name="Q3" type="double" default="0.0">Target Qy</input_port>
            <input_port name="Q4" type="double" default="0.0">Target Qz</input_port>
            <input_port name="Vel" type="double" default="50.0">Max velocity</input_port>
            <input_port name="CurrentVel" type="double" default="0.0">Start velocity</input_port>
            <input_port name="TargetVel" type="double" default="50.0">End velocity</input_port>
        </Action>
        <Action ID="BatchCmd">
            <input_port name="command" type="std::string">Command name (e.g. MoveL, MoveLGalvo)</input_port>
            <input_port name="segments" type="std::string">Pipe-separated segments, each comma-separated doubles in Arg enum order</input_port>
        </Action>
    </TreeNodesModel>

    <BehaviorTree ID="Cmd_JogabsJ">
        <Sequence>
            <Action ID="JogabsJ" AxisId="0" TargetPosition="10"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_Enable">
        <Sequence>
            <Action ID="Enable" AxisId="0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_Disable">
        <Sequence>
            <Action ID="Disable" AxisId="0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_Reset">
        <Sequence>
            <Action ID="Reset" AxisId="0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_Setmode">
        <Sequence>
            <Action ID="Setmode" AxisId="0" Mode="1"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_SetZero">
        <Sequence>
            <Action ID="SetZero" AxisId="0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_JogJ">
        <Sequence>
            <Action ID="JogJ" AxisId="0" TargetPosition="5"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveAbs">
        <Sequence>
            <Action ID="MoveAbs" AxisId="0" Position="100" Vel="50" Acc="100" Jerk="500"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveAbsJ">
        <Sequence>
            <Action ID="MoveAbsJ" Count="6" J1="0" J2="10" J3="20" J4="30" J5="40" J6="50"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveJ">
        <Sequence>
            <Action ID="MoveJ" X="100" Y="0" Z="100" RX="0" RY="0" RZ="0" Vel="0.5"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveL">
        <Sequence>
            <Action ID="MoveL"
                CurrentX="0" CurrentY="0" CurrentZ="0"
                CurrentQ1="1" CurrentQ2="0" CurrentQ3="0" CurrentQ4="0"
                X="100" Y="0" Z="0"
                Q1="1" Q2="0" Q3="0" Q4="0"
                Vel="100"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveC">
        <Sequence>
            <Action ID="MoveC" ViaX="50" ViaY="50" ViaZ="0" EndX="100" EndY="0" EndZ="0" Vel="50"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveL_Batch">
        <Sequence>
            <!-- 9段共线路径，所有路径点位于 X 轴上，参数与轴 motion 配置一致：maxVel=10, maxAcc=20, maxJerk=30 -->
            <Action ID="BatchCmd"
                command="MoveL"
                segments="
                    0,0,0,1,0,0,0, 20,0,0,1,0,0,0, 10,0,5|
                    20,0,0,1,0,0,0, 40,0,0,1,0,0,0, 10,5,5|
                    40,0,0,1,0,0,0, 60,0,0,1,0,0,0, 10,5,5|
                    60,0,0,1,0,0,0, 80,0,0,1,0,0,0, 10,5,5|
                    80,0,0,1,0,0,0, 100,0,0,1,0,0,0, 10,5,5|
                    100,0,0,1,0,0,0, 120,0,0,1,0,0,0, 10,5,5|
                    120,0,0,1,0,0,0, 140,0,0,1,0,0,0, 10,5,5|
                    140,0,0,1,0,0,0, 160,0,0,1,0,0,0, 10,5,5|
                    160,0,0,1,0,0,0, 180,0,0,1,0,0,0, 10,5,0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_Movehome">
        <Sequence>
            <Action ID="Movehome"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveLGalvo">
        <Sequence>
            <Action ID="MoveLGalvo"
                CurrentX="0" CurrentY="0" CurrentZ="0"
                CurrentQ1="1" CurrentQ2="0" CurrentQ3="0" CurrentQ4="0"
                X="100" Y="0" Z="0"
                Q1="1" Q2="0" Q3="0" Q4="0"
                Vel="100"/>
        </Sequence>
    </BehaviorTree>
</root>
