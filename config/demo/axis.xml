<?xml version="1.0" encoding="utf-8"?>
<!--
  demo 逻辑轴配置

  单位（控制器 SI）:
    - 位置 m, 速度 m/s, 加速度 m/s^2, jerk m/s^3
  数值由原 mm 量级 ÷1000 得到（示教用宽松限位）。
-->
<cereal>
	<axisConfig>
		<axes size="dynamic">
			<value0>
				<axisId>0</axisId>
				<axisName>xAxis</axisName>
				<servoSlaveIds size="dynamic">
					<value0>0</value0>
				</servoSlaveIds>
				<maxVel>0.01</maxVel>
				<maxAcc>0.02</maxAcc>
				<maxJerk>0.03</maxJerk>
				<posPositiveLimit>100.0</posPositiveLimit>
				<posNegativeLimit>-10.0</posNegativeLimit>
				<maxPosDiff>0</maxPosDiff>
				<lead>1</lead>
			</value0>
			<value1>
				<axisId>1</axisId>
				<axisName>yAxis</axisName>
				<servoSlaveIds size="dynamic">
					<value0>1</value0>
				</servoSlaveIds>
