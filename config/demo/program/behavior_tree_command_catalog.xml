<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="Cmd_MoveL_Batch">
    <!--
      命令行为树节点目录
      说明:
      1. 主树 CommandCatalog 只打印说明，不执行任何实际运动。
      2. 每个 BehaviorTree ID 对应一个 zrcs_rt 命令动作节点示例子树。
      3. 参数名与 CmdDefine.h 中 Arg 枚举成员名一致，类型为 double。
      4. 控制器 SI 单位：直线 m / m/s / m/s^2；姿态 rad（MoveJ 端口注释历史为 deg 时以代码为准）。
      5. 可在 GUI/Groot 中加载本文件，再切换 main_tree_to_execute 或复制对应子树使用。
    -->

    <TreeNodesModel>
        <Action ID="LogMessage">
            <input_port name="message" type="std::string">Log text</input_port>
        </Action>
        <Action ID="SetTaskState">
            <input_port name="state" type="std::string">Task state: RUN/STOP/RESET/START/SHUTDOWN</input_port>
        </Action>
        <!-- ===== Typed command nodes (one port per Arg enum member) ===== -->
        <Action ID="Enable">
            <input_port name="AxisId" type="double" default="0.0">Axis ID (0=all axes)</input_port>
        </Action>
        <Action ID="Disable">
            <input_port name="AxisId" type="double" default="0.0">Axis ID (0=all axes)</input_port>
        </Action>
        <Action ID="Reset">
            <input_port name="AxisId" type="double" default="0.0">Axis ID (0=all axes)</input_port>
        </Action>
        <Action ID="Setmode">
            <input_port name="AxisId" type="double" default="0.0">Axis ID</input_port>
            <input_port name="Mode" type="double" default="0.0">Operation mode</input_port>
        </Action>
        <Action ID="SetZero">
            <input_port name="AxisId" type="double" default="0.0">Axis ID</input_port>
        </Action>
        <Action ID="JogabsJ">
            <input_port name="AxisId" type="double" default="0.0">Axis ID</input_port>
            <input_port name="TargetPosition" type="double" default="0.0">Target position (m or rad)</input_port>
        </Action>
        <Action ID="JogJ">
            <input_port name="AxisId" type="double" default="0.0">Axis ID</input_port>
            <input_port name="TargetPosition" type="double" default="0.0">Target position (m or rad)</input_port>
        </Action>
        <Action ID="MoveAbs">
            <input_port name="AxisId" type="double" default="0.0">Axis ID</input_port>
            <input_port name="Position" type="double" default="0.0">Target position (m)</input_port>
            <input_port name="Vel" type="double" default="0.05">Max velocity (m/s)</input_port>
            <input_port name="Acc" type="double" default="0.1">Max acceleration (m/s^2)</input_port>
            <input_port name="Jerk" type="double" default="0.5">Max jerk (m/s^3)</input_port>
        </Action>
        <Action ID="MoveAbsJ">
            <input_port name="Count" type="double" default="6.0">Active joint count</input_port>
            <input_port name="J1" type="double" default="0.0">Joint 1 target (rad)</input_port>
            <input_port name="J2" type="double" default="0.0">Joint 2 target (rad)</input_port>
            <input_port name="J3" type="double" default="0.0">Joint 3 target (rad)</input_port>
            <input_port name="J4" type="double" default="0.0">Joint 4 target (rad)</input_port>
            <input_port name="J5" type="double" default="0.0">Joint 5 target (rad)</input_port>
            <input_port name="J6" type="double" default="0.0">Joint 6 target (rad)</input_port>
        </Action>
        <Action ID="MoveJ">
            <input_port name="X" type="double" default="0.0">Target X (m)</input_port>
            <input_port name="Y" type="double" default="0.0">Target Y (m)</input_port>
            <input_port name="Z" type="double" default="0.0">Target Z (m)</input_port>
            <input_port name="RX" type="double" default="0.0">Target RX (rad)</input_port>
            <input_port name="RY" type="double" default="0.0">Target RY (rad)</input_port>
            <input_port name="RZ" type="double" default="0.0">Target RZ (rad)</input_port>
            <input_port name="Vel" type="double" default="0.05">Max velocity (m/s)</input_port>
        </Action>
        <Action ID="MoveL">
            <input_port name="CurrentX" type="double" default="0.0">Start X (m)</input_port>
            <input_port name="CurrentY" type="double" default="0.0">Start Y (m)</input_port>
            <input_port name="CurrentZ" type="double" default="0.0">Start Z (m)</input_port>
            <input_port name="CurrentQ1" type="double" default="1.0">Start Qw</input_port>
            <input_port name="CurrentQ2" type="double" default="0.0">Start Qx</input_port>
            <input_port name="CurrentQ3" type="double" default="0.0">Start Qy</input_port>
            <input_port name="CurrentQ4" type="double" default="0.0">Start Qz</input_port>
            <input_port name="X" type="double" default="0.0">Target X (m)</input_port>
            <input_port name="Y" type="double" default="0.0">Target Y (m)</input_port>
            <input_port name="Z" type="double" default="0.0">Target Z (m)</input_port>
            <input_port name="Q1" type="double" default="1.0">Target Qw</input_port>
            <input_port name="Q2" type="double" default="0.0">Target Qx</input_port>
            <input_port name="Q3" type="double" default="0.0">Target Qy</input_port>
            <input_port name="Q4" type="double" default="0.0">Target Qz</input_port>
            <input_port name="Vel" type="double" default="0.05">Max velocity (m/s)</input_port>
            <input_port name="TargetVel" type="double" default="0.0">End velocity (m/s)</input_port>
            <input_port name="Sync" type="double" default="0.0">Reset arc offset for new group</input_port>
        </Action>
        <Action ID="MoveC">
            <input_port name="ViaX" type="double" default="0.0">Via point X (m)</input_port>
            <input_port name="ViaY" type="double" default="0.0">Via point Y (m)</input_port>
            <input_port name="ViaZ" type="double" default="0.0">Via point Z (m)</input_port>
            <input_port name="EndX" type="double" default="0.0">End point X (m)</input_port>
            <input_port name="EndY" type="double" default="0.0">End point Y (m)</input_port>
            <input_port name="EndZ" type="double" default="0.0">End point Z (m)</input_port>
            <input_port name="Vel" type="double" default="0.05">Max velocity (m/s)</input_port>
        </Action>
        <Action ID="Movehome">
            <!-- No input ports: Movehome takes zero parameters -->
        </Action>
        <Action ID="MoveLGalvo">
            <input_port name="CurrentX" type="double" default="0.0">Start X (m)</input_port>
            <input_port name="CurrentY" type="double" default="0.0">Start Y (m)</input_port>
            <input_port name="CurrentZ" type="double" default="0.0">Start Z (m)</input_port>
            <input_port name="CurrentQ1" type="double" default="1.0">Start Qw</input_port>
            <input_port name="CurrentQ2" type="double" default="0.0">Start Qx</input_port>
            <input_port name="CurrentQ3" type="double" default="0.0">Start Qy</input_port>
            <input_port name="CurrentQ4" type="double" default="0.0">Start Qz</input_port>
            <input_port name="X" type="double" default="0.0">Target X (m)</input_port>
            <input_port name="Y" type="double" default="0.0">Target Y (m)</input_port>
            <input_port name="Z" type="double" default="0.0">Target Z (m)</input_port>
            <input_port name="Q1" type="double" default="1.0">Target Qw</input_port>
            <input_port name="Q2" type="double" default="0.0">Target Qx</input_port>
            <input_port name="Q3" type="double" default="0.0">Target Qy</input_port>
            <input_port name="Q4" type="double" default="0.0">Target Qz</input_port>
            <input_port name="Vel" type="double" default="0.05">Max velocity (m/s)</input_port>
            <input_port name="TargetVel" type="double" default="0.0">End velocity (m/s)</input_port>
            <input_port name="Sync" type="double" default="0.0">Reset arc offset for new group</input_port>
        </Action>
        <Action ID="BatchCmd">
            <input_port name="command" type="std::string">Command name (e.g. MoveL, MoveLGalvo)</input_port>
            <input_port name="segments" type="std::string">Pipe-separated segments, each comma-separated doubles in Arg enum order</input_port>
        </Action>
    </TreeNodesModel>

    <BehaviorTree ID="Cmd_JogabsJ">
        <Sequence>
            <Action ID="JogabsJ" AxisId="0" TargetPosition="0.01"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_Enable">
        <Sequence>
            <Action ID="Enable" AxisId="0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_Disable">
        <Sequence>
            <Action ID="Disable" AxisId="0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_Reset">
        <Sequence>
            <Action ID="Reset" AxisId="0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_Setmode">
        <Sequence>
            <Action ID="Setmode" AxisId="0" Mode="1"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_SetZero">
        <Sequence>
            <Action ID="SetZero" AxisId="0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_JogJ">
        <Sequence>
            <Action ID="JogJ" AxisId="0" TargetPosition="0.005"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveAbs">
        <Sequence>
            <Action ID="MoveAbs" AxisId="0" Position="0.10" Vel="0.05" Acc="0.10" Jerk="0.50"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveAbsJ">
        <Sequence>
            <Action ID="MoveAbsJ" Count="6" J1="0" J2="0.17" J3="0.35" J4="0.52" J5="0.70" J6="0.87"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveJ">
        <Sequence>
            <Action ID="MoveJ" X="0.10" Y="0" Z="0.10" RX="0" RY="0" RZ="0" Vel="0.05"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveL">
        <Sequence>
            <Action ID="MoveL"
                CurrentX="0" CurrentY="0" CurrentZ="0"
                CurrentQ1="1" CurrentQ2="0" CurrentQ3="0" CurrentQ4="0"
                X="0.10" Y="0" Z="0"
                Q1="1" Q2="0" Q3="0" Q4="0"
                Vel="0.01" TargetVel="0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveC">
        <Sequence>
            <Action ID="MoveC" ViaX="0.05" ViaY="0.05" ViaZ="0" EndX="0.10" EndY="0" EndZ="0" Vel="0.05"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveL_Batch">
        <Sequence>
            <!-- 9段共线路径（m）；速度与 demo axis 量级一致：maxVel≈0.01 m/s -->
            <Action ID="BatchCmd"
                command="MoveL"
                segments="
                    0,0,0,1,0,0,0, 0.02,0,0,1,0,0,0, 0.01,0.005|
                    0.02,0,0,1,0,0,0, 0.04,0,0,1,0,0,0, 0.01,0.005|
                    0.04,0,0,1,0,0,0, 0.06,0,0,1,0,0,0, 0.01,0.005|
                    0.06,0,0,1,0,0,0, 0.08,0,0,1,0,0,0, 0.01,0.005|
                    0.08,0,0,1,0,0,0, 0.10,0,0,1,0,0,0, 0.01,0.005|
                    0.10,0,0,1,0,0,0, 0.12,0,0,1,0,0,0, 0.01,0.005|
                    0.12,0,0,1,0,0,0, 0.14,0,0,1,0,0,0, 0.01,0.005|
                    0.14,0,0,1,0,0,0, 0.16,0,0,1,0,0,0, 0.01,0.005|
                    0.16,0,0,1,0,0,0, 0.18,0,0,1,0,0,0, 0.01,0"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_Movehome">
        <Sequence>
            <Action ID="Movehome"/>
        </Sequence>
    </BehaviorTree>

    <BehaviorTree ID="Cmd_MoveLGalvo">
        <Sequence>
            <Action ID="MoveLGalvo"
                CurrentX="0" CurrentY="0" CurrentZ="0"
                CurrentQ1="1" CurrentQ2="0" CurrentQ3="0" CurrentQ4="0"
                X="0.10" Y="0" Z="0"
                Q1="1" Q2="0" Q3="0" Q4="0"
                Vel="0.05" TargetVel="0"/>
        </Sequence>
    </BehaviorTree>
</root>
