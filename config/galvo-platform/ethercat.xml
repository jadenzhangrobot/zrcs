<?xml version="1.0" encoding="UTF-8"?>
<ethercat>
    <!-- 平台 X 伺服电机 -->
    <slave-1 ID="0" PID="0x00000005" VID="0x00000083" assignActivate="300" configPdos="true" sync0Cycle="1000000" sync0Shift="300000" type="motor">
        <syncManager-1 dir="1" idx="0" watchDog="0"/>
        <syncManager-2 dir="2" idx="1" watchDog="0"/>
        <syncManager-3 dir="1" idx="2" watchDog="1">
            <pdo idx="1600">
                <pdoEntry-1 bitLen="32" idx="607A" name="TargetPosition" subIdx="00"/>
                <pdoEntry-2 bitLen="8" idx="6060" name="controlMode" subIdx="00"/>
                <pdoEntry-3 bitLen="16" idx="6040" name="ControlWord" subIdx="00"/>
            </pdo>
        </syncManager-3>
        <syncManager-4 dir="2" idx="3" watchDog="0">
            <pdo idx="1a00">
                <pdoEntry-1 bitLen="16" idx="6041" name="StatusWord" subIdx="00"/>
                <pdoEntry-2 bitLen="32" idx="6064" name="ActualPosition" subIdx="00"/>
            </pdo>
        </syncManager-4>
    </slave-1>

    <!-- 平台 Y 伺服电机 -->
    <slave-2 ID="1" PID="0x00000005" VID="0x00000083" assignActivate="300" configPdos="true" sync0Cycle="1000000" sync0Shift="300000" type="motor">
        <syncManager-1 dir="1" idx="0" watchDog="0"/>
        <syncManager-2 dir="2" idx="1" watchDog="0"/>
        <syncManager-3 dir="1" idx="2" watchDog="1">
            <pdo idx="1600">
                <pdoEntry-1 bitLen="32" idx="607A" name="TargetPosition" subIdx="00"/>
                <pdoEntry-2 bitLen="8" idx="6060" name="controlMode" subIdx="00"/>
                <pdoEntry-3 bitLen="16" idx="6040" name="ControlWord" subIdx="00"/>
            </pdo>
        </syncManager-3>
        <syncManager-4 dir="2" idx="3" watchDog="0">
            <pdo idx="1a00">
                <pdoEntry-1 bitLen="16" idx="6041" name="StatusWord" subIdx="00"/>
                <pdoEntry-2 bitLen="32" idx="6064" name="ActualPosition" subIdx="00"/>
            </pdo>
        </syncManager-4>
    </slave-2>

    <!-- 振镜 XY2-100 桥接卡 (作为标准伺服从站, 含 X/Y 两个通道) -->
    <!-- 注: 实际桥接卡 VID/PID 需根据硬件替换 -->
    <slave-3 ID="2" PID="0x00001001" VID="0x00000100" assignActivate="300" configPdos="true" sync0Cycle="1000000" sync0Shift="300000" type="motor">
        <syncManager-1 dir="1" idx="0" watchDog="0"/>
        <syncManager-2 dir="2" idx="1" watchDog="0"/>
        <syncManager-3 dir="1" idx="2" watchDog="1">
            <pdo idx="1600">
                <pdoEntry-1 bitLen="32" idx="607A" name="TargetPosition" subIdx="00"/>
                <pdoEntry-2 bitLen="16" idx="6040" name="ControlWord" subIdx="00"/>
            </pdo>
        </syncManager-3>
        <syncManager-4 dir="2" idx="3" watchDog="0">
            <pdo idx="1a00">
                <pdoEntry-1 bitLen="16" idx="6041" name="StatusWord" subIdx="00"/>
                <pdoEntry-2 bitLen="32" idx="6064" name="ActualPosition" subIdx="00"/>
            </pdo>
        </syncManager-4>
    </slave-3>

    <!-- 振镜 Y (桥接卡第二通道, 独立从站或子通道) -->
    <slave-4 ID="3" PID="0x00001001" VID="0x00000100" assignActivate="300" configPdos="true" sync0Cycle="1000000" sync0Shift="300000" type="motor">
        <syncManager-1 dir="1" idx="0" watchDog="0"/>
        <syncManager-2 dir="2" idx="1" watchDog="0"/>
        <syncManager-3 dir="1" idx="2" watchDog="1">
            <pdo idx="1600">
                <pdoEntry-1 bitLen="32" idx="607A" name="TargetPosition" subIdx="00"/>
                <pdoEntry-2 bitLen="16" idx="6040" name="ControlWord" subIdx="00"/>
            </pdo>
        </syncManager-3>
        <syncManager-4 dir="2" idx="3" watchDog="0">
            <pdo idx="1a00">
                <pdoEntry-1 bitLen="16" idx="6041" name="StatusWord" subIdx="00"/>
                <pdoEntry-2 bitLen="32" idx="6064" name="ActualPosition" subIdx="00"/>
            </pdo>
        </syncManager-4>
    </slave-4>

    <!-- 激光器 IO 模块 -->
    <slave-5 ID="4" PID="0x00002001" VID="0x00000200" assignActivate="300" configPdos="true" sync0Cycle="1000000" sync0Shift="300000" type="laser">
        <syncManager-1 dir="1" idx="0" watchDog="0"/>
        <syncManager-2 dir="2" idx="1" watchDog="0"/>
        <syncManager-3 dir="1" idx="2" watchDog="1">
            <pdo idx="1600">
                <pdoEntry-1 bitLen="8" idx="7000" name="LaserGate" subIdx="01"/>
                <pdoEntry-2 bitLen="16" idx="7010" name="LaserPower" subIdx="01"/>
                <pdoEntry-3 bitLen="16" idx="7020" name="LaserFrequency" subIdx="01"/>
                <pdoEntry-4 bitLen="16" idx="7030" name="LaserPulseWidth" subIdx="01"/>
            </pdo>
        </syncManager-3>
    </slave-5>
</ethercat>
