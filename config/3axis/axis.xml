<?xml version="1.0" encoding="utf-8"?>
<!--
  3axis 逻辑轴配置

  单位（控制器 SI）:
    - 直线轴 X/Y/Z: 位置 m, 速度 m/s, 加速度 m/s^2, jerk m/s^3
  MuJoCo 关节为 m；与控制器一致时 qposScale=1.0（见 mujoco.xml）。
-->
<cereal>
	<axisConfig>
		<axes size="dynamic">
			<value0>
				<axisId>0</axisId>
				<axisName>xAxis</axisName>
				<servoSlaveIds size="dynamic">
					<value0>0</value0>
				</servoSlaveIds>
				<maxVel>0.1</maxVel>
				<maxAcc>0.3</maxAcc>
				<maxJerk>3.0</maxJerk>
				<posPositiveLimit>100.0</posPositiveLimit>
				<posNegativeLimit>-100.0</posNegativeLimit>
				<maxPosDiff>0</maxPosDiff>
				<lead>1</lead>
			</value0>
			<value1>
				<axisId>1</axisId>
				<axisName>yAxis</axisName>
				<servoSlaveIds size="dynamic">
					<value0>1</value0>
				</servoSlaveIds>
				<maxVel>0.1</maxVel>
				<maxAcc>0.3</maxAcc>
				<maxJerk>3.0</maxJerk>
				<posPositiveLimit>100.0</posPositiveLimit>
				<posNegativeLimit>-100.0</posNegativeLimit>
				<maxPosDiff>0</maxPosDiff>
				<lead>1</lead>
			</value1>
			<value2>
				<axisId>2</axisId>
				<axisName>zAxis</axisName>
				<servoSlaveIds size="dynamic">
					<value0>2</value0>
				</servoSlaveIds>
				<maxVel>0.1</maxVel>
				<maxAcc>0.3</maxAcc>
				<maxJerk>3.0</maxJerk>
				<posPositiveLimit>100.0</posPositiveLimit>
				<posNegativeLimit>-100.0</posNegativeLimit>
				<maxPosDiff>0</maxPosDiff>
				<lead>1</lead>
			</value2>
		</axes>
	</axisConfig>
</cereal>
