<mujoco model="zrcs_3axis_cnc_visualizer">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.001" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096" offsamples="4"/>
    <headlight ambient="0.38 0.38 0.38" diffuse="0.62 0.62 0.62" specular="0.35 0.35 0.35"/>
    <map znear="0.01"/>
    <rgba haze="0.78 0.82 0.88 1"/>
  </visual>

  <statistic center="0 0 0.30" extent="1.20" meansize="0.08"/>

  <default>
    <joint damping="4" armature="0.01"/>
    <geom contype="1" conaffinity="1" friction="0.45 0.02 0.001"/>
  </default>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" width="512" height="512"
             rgb1="0.72 0.78 0.86" rgb2="0.94 0.96 0.98"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.62 0.67 0.72" rgb2="0.78 0.82 0.86"/>
    <material name="floor_grid" texture="grid" texrepeat="10 10" reflectance="0.16"/>
    <material name="cast_iron" rgba="0.20 0.20 0.21 1" specular="0.35" shininess="0.50"/>
    <material name="aluminum" rgba="0.75 0.75 0.75 1" specular="0.62" shininess="0.78"/>
    <material name="blue_cover" rgba="0.10 0.35 0.60 1" specular="0.45" shininess="0.60"/>
    <material name="rail_mat" rgba="0.88 0.88 0.88 1" specular="0.78" shininess="0.88"/>
    <material name="spindle_mat" rgba="0.53 0.53 0.53 1" specular="0.58" shininess="0.72"/>
    <material name="tool_mat" rgba="0.80 0.70 0.20 1" emission="0.08" specular="0.80" shininess="0.85"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="2.0 -2.0 3.0" dir="-0.5 0.5 -1" diffuse="1.0 0.98 0.92" specular="0.45 0.45 0.45"/>
    <light name="fill_light" pos="-2.0 1.4 2.0" dir="0.7 -0.4 -1" diffuse="0.55 0.62 0.72" specular="0.16 0.16 0.20"/>
    <camera name="overview" pos="1.20 -1.50 1.00" xyaxes="0.78 0.63 0 -0.33 0.41 0.85"/>
    <geom name="floor" type="plane" size="2.0 2.0 0.02" material="floor_grid"/>

    <body name="machine_bed" pos="0 0 0">
      <geom name="bed" type="box" pos="0 0 0.05" size="0.40 0.50 0.05" material="cast_iron"/>
      <geom name="table" type="box" pos="0 0 0.11" size="0.25 0.30 0.01" material="aluminum"/>
      <geom name="y_rail_left" type="box" pos="-0.35 0 0.1075" size="0.010 0.45 0.0075" material="rail_mat"/>
      <geom name="y_rail_right" type="box" pos="0.35 0 0.1075" size="0.010 0.45 0.0075" material="rail_mat"/>
    </body>

    <body name="y_gantry" pos="0 0 0">
      <joint name="y_slide" type="slide" axis="0 1 0" range="-0.30 0.30" damping="4"/>
      <geom name="pillar_left" type="box" pos="-0.35 0 0.30" size="0.05 0.075 0.20" material="blue_cover"/>
      <geom name="pillar_right" type="box" pos="0.35 0 0.30" size="0.05 0.075 0.20" material="blue_cover"/>
      <geom name="x_beam" type="box" pos="0 0 0.56" size="0.40 0.05 0.06" material="cast_iron"/>
      <geom name="x_rail_top" type="box" pos="0 0.06 0.60" size="0.35 0.010 0.0075" material="rail_mat"/>
      <geom name="x_rail_bottom" type="box" pos="0 0.06 0.52" size="0.35 0.010 0.0075" material="rail_mat"/>

      <body name="x_carriage" pos="0 0 0">
        <joint name="x_slide" type="slide" axis="1 0 0" range="-0.25 0.25" damping="4"/>
        <geom name="x_carriage_block" type="box" pos="0 0.08 0.56" size="0.06 0.03 0.075" material="blue_cover"/>

        <body name="z_head" pos="0 0 0">
          <joint name="z_slide" type="slide" axis="0 0 1" range="-0.15 0.05" damping="3"/>
          <geom name="z_plate" type="box" pos="0 0.13 0.56" size="0.04 0.02 0.10" material="cast_iron"/>
          <geom name="spindle" type="cylinder" pos="0 0.13 0.44" size="0.03 0.06" material="spindle_mat"/>
          <geom name="tool_holder" type="cylinder" pos="0 0.13 0.36" size="0.025 0.02" material="cast_iron"/>
          <geom name="tool" type="cylinder" pos="0 0.13 0.31" size="0.005 0.03" material="tool_mat"/>
          <geom name="tool_tip" type="sphere" pos="0 0.13 0.28" size="0.002" rgba="1 0 0 0" contype="0" conaffinity="0"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
