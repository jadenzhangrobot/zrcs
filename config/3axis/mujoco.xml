<?xml version="1.0" encoding="utf-8"?>
<!--
  3axis MuJoCo binding

  Controller units (axis.xml): meter / radian
  MuJoCo joint units: meter / radian
  => qposScale = 1.0 for all axes
-->
<cereal>
	<mujocoConfig>
		<model>mujoco/robot.xml</model>
		<timestepMs>1</timestepMs>
		<substeps>1</substeps>
		<kinematicOnly>false</kinematicOnly>
		<servos size="dynamic">
			<value0>
				<slaveId>0</slaveId>
				<joint>x_slide</joint>
				<kp>800</kp>
				<kd>40</kd>
				<qposScale>1</qposScale>
				<qposOffset>0</qposOffset>
			</value0>
			<value1>
				<slaveId>1</slaveId>
				<joint>y_slide</joint>
				<kp>800</kp>
				<kd>40</kd>
				<qposScale>1</qposScale>
				<qposOffset>0</qposOffset>
			</value1>
			<value2>
				<slaveId>2</slaveId>
				<joint>z_slide</joint>
				<kp>800</kp>
				<kd>40</kd>
				<qposScale>1</qposScale>
				<qposOffset>0</qposOffset>
			</value2>
		</servos>
	</mujocoConfig>
</cereal>

