<!--
  5axis MuJoCo binding

  Controller units (axis.xml / model.xml): meter / radian
  MuJoCo joint units: meter / radian
  => qposScale = 1.0 for all axes

  slaveId must match servo.xml:
    0=X, 1=Y, 2=Z, 3=A, 4=C

  kinematicOnly:
    false/缺省 = 动力学 mj_step（辨识、力控）
    true       = 纯运动学写 qpos（只要可视化跟随）
-->
<mujocoConfig model="mujoco/robot.xml" timestepMs="1.0" substeps="1" kinematicOnly="true">
  <servo slaveId="0" joint="x_slide" kp="800.0" kd="40.0" qposScale="1.0" qposOffset="0.0"/>
  <servo slaveId="1" joint="y_slide" kp="800.0" kd="40.0" qposScale="1.0" qposOffset="0.0"/>
  <servo slaveId="2" joint="z_slide" kp="800.0" kd="40.0" qposScale="1.0" qposOffset="0.0"/>
  <servo slaveId="3" joint="a_hinge" kp="500.0" kd="30.0" qposScale="1.0" qposOffset="0.0"/>
  <servo slaveId="4" joint="c_hinge" kp="500.0" kd="30.0" qposScale="1.0" qposOffset="0.0"/>
</mujocoConfig>
