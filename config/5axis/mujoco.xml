<?xml version="1.0" encoding="utf-8"?>
<!--
  5axis MuJoCo binding

  Controller units (axis.xml / model.xml): meter / radian
  MuJoCo joint units: meter / radian
  => qposScale = 1.0 for all axes

  slaveId must match servo.xml:
    0=X, 1=Y, 2=Z, 3=A, 4=C

  kinematicOnly:
    false/缺省 = 动力学 mj_step（辨识、力控）
    true       = 纯运动学写 qpos（只要可视化跟随）
-->
<cereal>
	<mujocoConfig>
		<model>mujoco/robot.xml</model>
		<timestepMs>1</timestepMs>
		<substeps>1</substeps>
		<kinematicOnly>true</kinematicOnly>
		<servos size="dynamic">
			<value0>
				<slaveId>0</slaveId>
				<joint>x_slide</joint>
				<kp>800</kp>
				<kd>40</kd>
				<qposScale>1</qposScale>
				<qposOffset>0</qposOffset>
			</value0>
			<value1>
				<slaveId>1</slaveId>
				<joint>y_slide</joint>
				<kp>800</kp>
				<kd>40</kd>
				<qposScale>1</qposScale>
				<qposOffset>0</qposOffset>
			</value1>
			<value2>
				<slaveId>2</slaveId>
				<joint>z_slide</joint>
				<kp>800</kp>
				<kd>40</kd>
				<qposScale>1</qposScale>
				<qposOffset>0</qposOffset>
			</value2>
			<value3>
				<slaveId>3</slaveId>
				<joint>a_hinge</joint>
				<kp>500</kp>
				<kd>30</kd>
				<qposScale>1</qposScale>
				<qposOffset>0</qposOffset>
			</value3>
			<value4>
				<slaveId>4</slaveId>
				<joint>c_hinge</joint>
				<kp>500</kp>
				<kd>30</kd>
				<qposScale>1</qposScale>
				<qposOffset>0</qposOffset>
			</value4>
		</servos>
	</mujocoConfig>
</cereal>

