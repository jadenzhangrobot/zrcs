<?xml version="1.0"?>
<root main_tree_to_execute="Cmd_NcSphereHexGrid">
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_Disable">
        <Sequence>
            <Action AxisId="0" ID="Disable"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_Enable">
        <Sequence>
            <Action AxisId="0" ID="Enable"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_JogJ">
        <Sequence>
            <Action AxisId="0" ID="JogJ" TargetPosition="0.01"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_JogabsJ">
        <Sequence>
            <Action AxisId="0" ID="JogabsJ" TargetPosition="0.05"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_MoveAbs">
        <Sequence>
            <Action Acc="0.3" AxisId="0" ID="MoveAbs" Jerk="3.0" Position="0.10" Vel="0.05"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_MoveAbsJ">
        <Sequence>
            <Action Count="6" ID="MoveAbsJ" J1="0" J2="10" J3="20" J4="30" J5="40" J6="50"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <!-- Cartesian demos use controller SI: m / m/s (5axis soft limits ~±0.4 m) -->
    <BehaviorTree ID="Cmd_MoveC">
        <Sequence>
            <Action EndX="0.10" EndY="0" EndZ="0.10" ID="MoveC" Vel="0.05" ViaX="0.05" ViaY="0.05" ViaZ="0.10"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_MoveJ">
        <Sequence>
            <Action ID="MoveJ" RX="0" RY="0" RZ="0" Vel="0.05" X="0.10" Y="0" Z="0.10"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_MoveL">
        <Sequence>
            <Action CurrentQ1="1" CurrentQ2="0" CurrentQ3="0" CurrentQ4="0" CurrentX="0" CurrentY="0" CurrentZ="0.10" ID="MoveL" Q1="1" Q2="0" Q3="0" Q4="0" TargetVel="0.0" Vel="0.10" X="0.10" Y="0" Z="0.10"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_MoveLGalvo">
        <Sequence>
            <Action CurrentQ1="1" CurrentQ2="0" CurrentQ3="0" CurrentQ4="0" CurrentX="0" CurrentY="0" CurrentZ="0.10" ID="MoveLGalvo" Q1="1" Q2="0" Q3="0" Q4="0" TargetVel="0.0" Vel="0.10" X="0.10" Y="0" Z="0.10"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_MoveL_Batch">
        <Sequence>
            <Action ID="BatchCmd" command="MoveL" segments="0,0,0.10,1,0,0,0, 0.02,0,0.10,1,0,0,0, 0.05,0|0.02,0,0.10,1,0,0,0, 0.04,0,0.10,1,0,0,0, 0.05,0|0.04,0,0.10,1,0,0,0, 0.06,0,0.10,1,0,0,0, 0.05,0|0.06,0,0.10,1,0,0,0, 0.08,0,0.10,1,0,0,0, 0.05,0|0.08,0,0.10,1,0,0,0, 0.10,0,0.10,1,0,0,0, 0.05,0"/>
            <Action AxisId="0.0" ID="JogabsJ" TargetPosition="0.0"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_NcPath">
        <Sequence>
            <Action ID="NcParse" filePath="config/5axis/program/demo_butterfly.nc"
                    waypoints="{path_pts}" feedrates="{path_feeds}"/>
            <!-- PathMove units: m / m/s (NcParse: G21 mm→m, F mm/s→m/s) -->
            <Action ID="PathMove" waypoints="{path_pts}" feedrates="{path_feeds}"
                    rx="0.0" ry="0.0" rz="0.0"
                    endRx="0.5" endRy="0.0" endRz="1.57"
                    maxVel="1.2" maxAccel="2.5" maxJerk="15.0"
                    cornerTol="0.001" minSegLen="0.00005"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <!-- Simultaneous XYZAC butterfly engraving with tool axis normal to the R40 sphere -->
    <BehaviorTree ID="Cmd_NcMapleCarve">
        <Sequence>
            <Action ID="NcParse" filePath="config/5axis/program/maple.nc"
                    waypoints="{path_pts}" orientations="{path_orientations}"
                    feedrates="{path_feeds}"/>
            <Action ID="PathMove" waypoints="{path_pts}"
                    orientations="{path_orientations}" feedrates="{path_feeds}"
                    rx="0.0" ry="0.0" rz="0.0"
                    endRx="0.0" endRy="0.0" endRz="0.0"
                    maxVel="0.03" maxAccel="0.5" maxJerk="5.0"
                    cornerTol="0.0" minSegLen="0.0"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <!-- Continuous RTCP hex grid over the reachable R40 upper hemisphere -->
    <BehaviorTree ID="Cmd_NcSphereHexGrid">
        <Sequence>
            <Action ID="NcParse" filePath="config/5axis/program/sphere_hex_grid.nc"
                    waypoints="{path_pts}" orientations="{path_orientations}"
                    feedrates="{path_feeds}"/>
            <Action ID="PathMove" waypoints="{path_pts}"
                    orientations="{path_orientations}" feedrates="{path_feeds}"
                    rx="0.0" ry="0.0" rz="0.0"
                    endRx="0.0" endRy="0.0" endRz="0.0"
                    maxVel="0.03" maxAccel="0.5" maxJerk="5.0"
                    cornerTol="0.0" minSegLen="0.0"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <!-- Hexagonal spiral carved on R40 sphere -->
    <BehaviorTree ID="Cmd_NcHexagonCarve">
        <Sequence>
            <Action ID="NcParse" filePath="config/5axis/program/hexagon.nc"
                    waypoints="{path_pts}" feedrates="{path_feeds}"/>
            <Action ID="PathMove" waypoints="{path_pts}" feedrates="{path_feeds}"
                    rx="0.0" ry="0.0" rz="0.0"
                    endRx="0.0" endRy="0.0" endRz="0.0"
                    maxVel="0.08" maxAccel="0.8" maxJerk="8.0"
                    cornerTol="0.0002" minSegLen="0.00005"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <!-- Sphere-surface carve: spiral + latitude rings + meridians + polar rosette -->
    <BehaviorTree ID="Cmd_NcSphereCarve">
        <Sequence>
            <Action ID="NcParse" filePath="config/5axis/program/demo_sphere_carve.nc"
                    waypoints="{path_pts}" feedrates="{path_feeds}"/>
            <!-- Keep A/C fixed (tool normal ~ -Z); path already lies on R=40 mm sphere -->
            <Action ID="PathMove" waypoints="{path_pts}" feedrates="{path_feeds}"
                    rx="0.0" ry="0.0" rz="0.0"
                    endRx="0.0" endRy="0.0" endRz="0.0"
                    maxVel="0.8" maxAccel="2.0" maxJerk="12.0"
                    cornerTol="0.0005" minSegLen="0.00005"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_Movehome">
        <Sequence>
            <Action ID="Movehome"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_Reset">
        <Sequence>
            <Action AxisId="0" ID="Reset"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_SetZero">
        <Sequence>
            <Action AxisId="0" ID="SetZero"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <BehaviorTree ID="Cmd_Setmode">
        <Sequence>
            <Action AxisId="0" ID="Setmode" Mode="1"/>
        </Sequence>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="BatchCmd">
            <input_port name="command" type="std::string">Command name (e.g. MoveL, MoveLGalvo)</input_port>
            <input_port name="segments" type="std::string">Pipe-separated segments, each comma-separated doubles in Arg enum order</input_port>
        </Action>
        <Action ID="NcParse">
            <input_port name="filePath" type="std::string">Path to .nc / G-code file</input_port>
            <input_port default="0.0002" name="arcChordTol" type="double">Arc sampling chord height (m)</input_port>
            <output_port name="waypoints">Parsed path points (m)</output_port>
            <output_port name="orientations">Per-waypoint A/B/C orientation (rad)</output_port>
            <output_port name="feedrates">Per-edge feedrates (m/s)</output_port>
        </Action>
        <Action ID="PathMove">
            <input_port name="waypoints">Path points from NcParse (m)</input_port>
            <input_port name="orientations">Optional per-waypoint A/B/C orientation (rad)</input_port>
            <input_port name="feedrates">Optional per-edge feedrates from NcParse (m/s)</input_port>
            <input_port default="0.0" name="rx" type="double">Start RX / A (rad)</input_port>
            <input_port default="0.0" name="ry" type="double">Start RY (rad)</input_port>
            <input_port default="0.0" name="rz" type="double">Start RZ / C (rad)</input_port>
            <input_port default="0.0" name="endRx" type="double">End RX / A (rad)</input_port>
            <input_port default="0.0" name="endRy" type="double">End RY (rad)</input_port>
            <input_port default="0.0" name="endRz" type="double">End RZ / C (rad)</input_port>
            <input_port default="0.15" name="maxVel" type="double">Max path velocity (m/s)</input_port>
            <input_port default="0.8" name="maxAccel" type="double">Max path acceleration</input_port>
            <input_port default="8.0" name="maxJerk" type="double">Max path jerk</input_port>
            <input_port default="0.00025" name="cornerTol" type="double">Corner blend tolerance (m)</input_port>
            <input_port default="0.00005" name="minSegLen" type="double">Minimum retained line length (m)</input_port>
        </Action>
        <Action ID="Disable">
            <input_port default="0.0" name="AxisId" type="double">Axis ID (0=all axes)</input_port>
        </Action>
        <Action ID="Enable">
            <input_port default="0.0" name="AxisId" type="double">Axis ID (0=all axes)</input_port>
        </Action>
        <Action ID="JogJ">
            <input_port default="0.0" name="AxisId" type="double">Axis ID</input_port>
            <input_port default="0.0" name="TargetPosition" type="double">Target position</input_port>
        </Action>
        <Action ID="JogabsJ">
            <input_port default="0.0" name="AxisId" type="double">Axis ID</input_port>
            <input_port default="0.0" name="TargetPosition" type="double">Target position</input_port>
        </Action>
        <Action ID="LogMessage">
            <input_port name="message" type="std::string">Log text</input_port>
        </Action>
        <Action ID="MoveAbs">
            <input_port default="100.0" name="Acc" type="double">Max acceleration</input_port>
            <input_port default="0.0" name="AxisId" type="double">Axis ID</input_port>
            <input_port default="500.0" name="Jerk" type="double">Max jerk</input_port>
            <input_port default="0.0" name="Position" type="double">Target position</input_port>
            <input_port default="50.0" name="Vel" type="double">Max velocity</input_port>
        </Action>
        <Action ID="MoveAbsJ">
            <input_port default="6.0" name="Count" type="double">Active joint count</input_port>
            <input_port default="0.0" name="J1" type="double">Joint 1 target</input_port>
            <input_port default="0.0" name="J2" type="double">Joint 2 target</input_port>
            <input_port default="0.0" name="J3" type="double">Joint 3 target</input_port>
            <input_port default="0.0" name="J4" type="double">Joint 4 target</input_port>
            <input_port default="0.0" name="J5" type="double">Joint 5 target</input_port>
            <input_port default="0.0" name="J6" type="double">Joint 6 target</input_port>
        </Action>
        <Action ID="MoveC">
            <input_port default="0.0" name="EndX" type="double">End point X</input_port>
            <input_port default="0.0" name="EndY" type="double">End point Y</input_port>
            <input_port default="0.0" name="EndZ" type="double">End point Z</input_port>
            <input_port default="50.0" name="Vel" type="double">Max velocity</input_port>
            <input_port default="0.0" name="ViaX" type="double">Via point X</input_port>
            <input_port default="0.0" name="ViaY" type="double">Via point Y</input_port>
            <input_port default="0.0" name="ViaZ" type="double">Via point Z</input_port>
        </Action>
        <Action ID="MoveJ">
            <input_port default="0.0" name="RX" type="double">Target RX (deg)</input_port>
            <input_port default="0.0" name="RY" type="double">Target RY (deg)</input_port>
            <input_port default="0.0" name="RZ" type="double">Target RZ (deg)</input_port>
            <input_port default="50.0" name="Vel" type="double">Max velocity</input_port>
            <input_port default="0.0" name="X" type="double">Target X (m)</input_port>
            <input_port default="0.0" name="Y" type="double">Target Y (m)</input_port>
            <input_port default="0.0" name="Z" type="double">Target Z (m)</input_port>
        </Action>
        <Action ID="MoveL">
            <input_port default="1.0" name="CurrentQ1" type="double">Start Qw</input_port>
            <input_port default="0.0" name="CurrentQ2" type="double">Start Qx</input_port>
            <input_port default="0.0" name="CurrentQ3" type="double">Start Qy</input_port>
            <input_port default="0.0" name="CurrentQ4" type="double">Start Qz</input_port>
            <input_port default="0.0" name="CurrentX" type="double">Start X</input_port>
            <input_port default="0.0" name="CurrentY" type="double">Start Y</input_port>
            <input_port default="0.0" name="CurrentZ" type="double">Start Z</input_port>
            <input_port default="1.0" name="Q1" type="double">Target Qw</input_port>
            <input_port default="0.0" name="Q2" type="double">Target Qx</input_port>
            <input_port default="0.0" name="Q3" type="double">Target Qy</input_port>
            <input_port default="0.0" name="Q4" type="double">Target Qz</input_port>
            <input_port default="50.0" name="TargetVel" type="double">End velocity</input_port>
            <input_port default="50.0" name="Vel" type="double">Max velocity</input_port>
            <input_port default="0.0" name="X" type="double">Target X</input_port>
            <input_port default="0.0" name="Y" type="double">Target Y</input_port>
            <input_port default="0.0" name="Z" type="double">Target Z</input_port>
            <input_port default="0.0" name="Sync" type="double">Reset arc offset for new group</input_port>
        </Action>
        <Action ID="MoveLGalvo">
            <input_port default="1.0" name="CurrentQ1" type="double">Start Qw</input_port>
            <input_port default="0.0" name="CurrentQ2" type="double">Start Qx</input_port>
            <input_port default="0.0" name="CurrentQ3" type="double">Start Qy</input_port>
            <input_port default="0.0" name="CurrentQ4" type="double">Start Qz</input_port>
            <input_port default="0.0" name="CurrentX" type="double">Start X</input_port>
            <input_port default="0.0" name="CurrentY" type="double">Start Y</input_port>
            <input_port default="0.0" name="CurrentZ" type="double">Start Z</input_port>
            <input_port default="1.0" name="Q1" type="double">Target Qw</input_port>
            <input_port default="0.0" name="Q2" type="double">Target Qx</input_port>
            <input_port default="0.0" name="Q3" type="double">Target Qy</input_port>
            <input_port default="0.0" name="Q4" type="double">Target Qz</input_port>
            <input_port default="50.0" name="TargetVel" type="double">End velocity</input_port>
            <input_port default="50.0" name="Vel" type="double">Max velocity</input_port>
            <input_port default="0.0" name="X" type="double">Target X</input_port>
            <input_port default="0.0" name="Y" type="double">Target Y</input_port>
            <input_port default="0.0" name="Z" type="double">Target Z</input_port>
            <input_port default="0.0" name="Sync" type="double">Reset arc offset for new group</input_port>
        </Action>
        <Action ID="Movehome"/>
        <Action ID="Reset">
            <input_port default="0.0" name="AxisId" type="double">Axis ID (0=all axes)</input_port>
        </Action>
        <Action ID="SetTaskState">
            <input_port name="state" type="std::string">Task state: RUN/STOP/RESET/START/SHUTDOWN</input_port>
        </Action>
        <Action ID="SetZero">
            <input_port default="0.0" name="AxisId" type="double">Axis ID</input_port>
        </Action>
        <Action ID="Setmode">
            <input_port default="0.0" name="AxisId" type="double">Axis ID</input_port>
            <input_port default="0.0" name="Mode" type="double">Operation mode</input_port>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
