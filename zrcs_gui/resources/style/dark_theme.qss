/* ZRCS GUI 深色主题样式表 */

/* 主窗口 */
QMainWindow {
    background-color: #0f0f0f;
}

/* 通用 Widget */
QWidget {
    background-color: #1a1a1a;
    color: #CCCCCC;
}

/* 菜单栏 */
QMenuBar {
    background-color: #2a2a2a;
    color: #CCCCCC;
    border-bottom: 1px solid #444;
}

QMenuBar::item:selected {
    background-color: #3a3a3a;
}

/* 菜单 */
QMenu {
    background-color: #2a2a2a;
    color: #CCCCCC;
}

QMenu::item:selected {
    background-color: #3a3a3a;
}

/* 状态栏 */
QStatusBar {
    background-color: #2a2a2a;
    color: #CCCCCC;
    border-top: 1px solid #444;
}

/* 标签页 */
QTabWidget::pane {
    border: 1px solid #444;
}

QTabBar::tab {
    background-color: #2a2a2a;
    color: #CCCCCC;
    padding: 8px 20px;
    border: 1px solid #444;
}

QTabBar::tab:selected {
    background-color: #3a3a3a;
    color: #FFD700;
    border-bottom: 2px solid #FFD700;
}

/* 按钮 */
QPushButton {
    background-color: #2a2a2a;
    color: #CCCCCC;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 6px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #3a3a3a;
}

QPushButton:pressed {
    background-color: #1a1a1a;
}

/* 绿色按钮（正常操作） */
QPushButton.greenButton {
    background-color: #2a5a2a;
    color: #00FF00;
    border: 1px solid #00FF00;
}

QPushButton.greenButton:hover {
    background-color: #3a7a3a;
}

/* 黄色按钮（警告操作） */
QPushButton.yellowButton {
    background-color: #5a5a2a;
    color: #FFD700;
    border: 1px solid #FFD700;
}

QPushButton.yellowButton:hover {
    background-color: #7a7a3a;
}

/* 红色按钮（危险操作） */
QPushButton.redButton {
    background-color: #5a2a2a;
    color: #FF6347;
    border: 1px solid #FF6347;
}

QPushButton.redButton:hover {
    background-color: #7a3a3a;
}

/* 文本输入框 */
QLineEdit {
    background-color: #2a2a2a;
    color: #00FF00;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 5px;
    font-family: monospace;
}

/* 数值输入框 */
QSpinBox {
    background-color: #2a2a2a;
    color: #00FF00;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 5px;
}

/* 下拉框 */
QComboBox {
    background-color: #2a2a2a;
    color: #CCCCCC;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 5px;
}

/* 标签 */
QLabel {
    color: #CCCCCC;
}

/* 分组框 */
QGroupBox {
    color: #FFD700;
    border: 1px solid #444;
    border-radius: 5px;
    padding-top: 10px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
}

/* 高亮分组框 */
QGroupBox.highlight {
    color: #FFD700;
    border: 2px solid #FFD700;
}

/* 滑块 */
QSlider::groove:horizontal {
    background: #444;
    height: 8px;
}

QSlider::handle:horizontal {
    background: #00FF00;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

/* 表格 */
QTableWidget {
    background-color: #1a1a1a;
    color: #CCCCCC;
    border: 1px solid #444;
}

QHeaderView::section {
    background-color: #2a2a2a;
    color: #FFD700;
    padding: 5px;
    border: 1px solid #444;
}

QTableWidget::item {
    padding: 5px;
    border-bottom: 1px solid #333;
}

/* 文本编辑框 */
QTextEdit {
    background-color: #0a0a0a;
    color: #00FF00;
    border: 1px solid #444;
    font-family: monospace;
    font-size: 9pt;
}

/* 滚动区域 */
QScrollArea {
    background-color: #1a1a1a;
    border: none;
}

/* 滚动条 */
QScrollBar:vertical {
    background-color: #1a1a1a;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #444;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #555;
}

QScrollBar:horizontal {
    background-color: #1a1a1a;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #444;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #555;
}

/* 消息框 */
QMessageBox {
    background-color: #1a1a1a;
}

QMessageBox QLabel {
    color: #CCCCCC;
}

#centralRoot {
    background: #0c0f14;
}

QWidget#leftSidebarHost {
    background: transparent;
}

QScrollArea#leftScrollArea {
    background: transparent;
    border: 1px solid #242b38;
    border-radius: 10px;
}

QPushButton#btnControlPanelToggle {
    background: transparent;
    border: none;
    border-left: 1px solid #f3f6fb;
    border-radius: 0;
    padding: 0;
    min-width: 2px;
    max-width: 2px;
}

QPushButton#btnControlPanelToggle:hover {
    background: transparent;
    border-left-color: #ffffff;
}

QPushButton#btnControlPanelToggle:pressed,
QPushButton#btnControlPanelToggle:focus {
    background: transparent;
    border-left: 1px solid #ffffff;
}

QScrollArea#leftScrollArea > QWidget > QWidget {
    background: #11151d;
    border-radius: 10px;
}

QTabWidget#mainTabs::pane {
    border: 1px solid #283142;
    border-radius: 10px;
    background: #111722;
}

QTabBar::tab {
    background: #131a25;
    color: #9facbf;
    border: 1px solid #293346;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 10px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #1c2635;
    color: #dce7f7;
    border-color: #4f6787;
}

QPushButton {
    background: #1a2330;
    color: #d6deea;
    border: 1px solid #334154;
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: 500;
}

QGroupBox#quickActionGroup QPushButton[quickAction="true"] {
    min-height: 36px;
}

QStatusBar QLineEdit#statusBarIpInput {
    min-width: 140px;
    max-width: 140px;
}

QStatusBar QPushButton#statusBarConnectBtn {
    min-width: 60px;
    max-width: 60px;
}

QPushButton:hover {
    background: #223044;
    border-color: #4d6b92;
}

QPushButton:pressed {
    background: #161f2c;
}

QPushButton:checked {
    background: #2f6feb;
    border-color: #5f8fff;
    color: #ffffff;
}

QPushButton[compact="true"] {
    padding: 4px 6px;
    border-radius: 6px;
    min-width: 56px;
    max-width: 56px;
}

QPushButton[compact="true"][kind="secondary"] {
    min-width: 86px;
    max-width: 96px;
}

QPushButton[kind="secondary"] {
    background: #1f2b21;
    border-color: #3f6448;
    color: #a8d9b3;
}

QPushButton[kind="secondary"]:hover {
    background: #27402d;
    border-color: #5a8a67;
}

QPushButton[kind="danger"] {
    background: #321c22;
    border-color: #6e3c49;
    color: #ffb8c3;
}

QPushButton[kind="danger"]:hover {
    background: #44242c;
    border-color: #a65569;
}

QPushButton[kind="warning"] {
    background: #403820;
    border-color: #b8963c;
    color: #ffe082;
}

QPushButton[kind="warning"]:hover {
    background: #544a28;
    border-color: #d4a848;
}

QPushButton[kind="info"] {
    background: #1e3a5f;
    border-color: #4a8bc2;
    color: #a8d8ff;
}

QPushButton[kind="info"]:hover {
    background: #264a78;
    border-color: #5a9bd2;
}

QPushButton[kind="accent"] {
    background: #2a4a2a;
    border-color: #58b658;
    color: #b7ffb7;
}

QPushButton[kind="accentBlue"] {
    background: #2a4a6a;
    border-color: #66a3ff;
    color: #9fd1ff;
}

QPushButton[kind="neutral"] {
    background: #33465d;
    border-color: #6f8fb8;
    color: #d7e7ff;
}

QLabel#axisPosDisplay {
    border: 1px solid #2e5b8a;
    border-radius: 10px;
    padding: 0 8px;
    background-color: #101a2b;
    color: #9fc8ff;
}

QLabel#statusLabel {
    color: #FF6347;
    font-weight: bold;
}

QLabel#statusLabel[state="connected"] {
    color: #00FF00;
}

StatusIndicator#globalStatusIndicator {
    color: #f3f6fb;
    font: 700 10pt "Microsoft YaHei UI";
}
